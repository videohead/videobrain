# VideoBrain MCP service: FastMCP tools over Streamable HTTP, plus npm/git for
# run_npm_script and git_status. See docker-compose.mcp.yml.
FROM node:22-bookworm-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    VIDEOBRAIN_ROOT=/app \
    MCP_TRANSPORT=streamable-http \
    MCP_HTTP_HOST=0.0.0.0 \
    MCP_HTTP_PORT=8932

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip git \
    && rm -rf /var/lib/apt/lists/*

# npm scripts (lint/typecheck/test/build) need real deps, so install them into
# the image; docker-compose.mcp.yml keeps this node_modules with an anonymous
# volume even though the rest of the repo is bind-mounted over it.
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

WORKDIR /opt/videobrain-mcp
COPY mcp/requirements.txt ./requirements.txt
RUN pip3 install --break-system-packages -r requirements.txt

COPY mcp/server.py ./server.py
COPY mcp/test_server.py ./test_server.py

# The authoring knowledge pack is generated from the production registry by
# scripts/export-graph-knowledge.mjs (npm run build:mcp-knowledge). Baking it
# in means the server still answers if the bind mount lacks a fresh copy;
# VIDEOBRAIN_KNOWLEDGE can point at a regenerated one.
COPY mcp/graph-knowledge.json ./graph-knowledge.json

# Repository source is bind-mounted at /app, see docker-compose.mcp.yml.
# validate_graph runs scripts/inspect-graph.mjs from that mount.
EXPOSE 8932

CMD ["python3", "/opt/videobrain-mcp/server.py"]
