# VideoBrain Polling API: simple HTTP polling for graph/control
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    POLLING_HOST=0.0.0.0 \
    POLLING_PORT=8934

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server/polling-api.mjs ./server/polling-api.mjs

# Ensure data directory exists
RUN mkdir -p /app/data

EXPOSE 8934

CMD ["node", "server/polling-api.mjs"]