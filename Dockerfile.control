# VideoBrain realtime control API: relays GET/POST JSON into the live
# project store over a WebSocket bridge. See server/control-server.mjs and
# src/controlBridge.ts.
FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    CONTROL_HOST=0.0.0.0 \
    CONTROL_PORT=8933

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server/control-server.mjs ./server/control-server.mjs

EXPOSE 8933

CMD ["node", "server/control-server.mjs"]
