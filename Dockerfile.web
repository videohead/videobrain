# VideoBrain static site: builds the Vite production bundle and serves it
# with nginx. See vite.config.ts.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Served behind Traefik's /videobrain path prefix, so assets must resolve there.
RUN npx tsc -b && npx vite build --base=/videobrain/

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
